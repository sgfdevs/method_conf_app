class Env {
  Env._();

  static const methodBaseUrl = String.fromEnvironment(
    'METHOD_BASE_URL',
    defaultValue: 'https://www.methodconf.com',
  );
  static const sentryDsn = String.fromEnvironment('SENTRY_DSN');
  static const enableErrorTracking = bool.fromEnvironment(
    'ENABLE_ERROR_TRACKING',
  );
  static const enableAnalytics = bool.fromEnvironment('ENABLE_ANALYTICS');
  static const plausibleServerUrl = String.fromEnvironment(
    'PLAUSIBLE_SERVER_URL',
    defaultValue: 'https://plausible.sgf.dev',
  );
  static const plausibleDomain = String.fromEnvironment(
    'PLAUSIBLE_DOMAIN',
    defaultValue: 'mobile.methodconf.com',
  );
  static const umbracoBaseUrl = String.fromEnvironment(
    'UMBRACO_BASE_URL',
    defaultValue: 'https://cms.methodconf.com',
  );
}
